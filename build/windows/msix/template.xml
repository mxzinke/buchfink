<?xml version="1.0" encoding="utf-8"?>
<MsixPackagingToolTemplate
    xmlns="http://schemas.microsoft.com/msix/packaging/msixpackagingtool/template/2022">
    <Settings
        AllowTelemetry="false"
        ApplyACLsToPackageFiles="true"
        GenerateCommandLineFile="true"
        AllowPromptForPassword="false">
    </Settings>
    <Installer
        Path="buchfink"
        Arguments=""
        InstallLocation="C:\Program Files\Buchfink">
    </Installer>
    <PackageInformation
        PackageName="Buchfink"
        PackageDisplayName="Buchfink"
        PublisherName="CN=Buchfink Open Source"
        PublisherDisplayName="Buchfink Open Source"
        Version="0.3.0.0"
        PackageDescription="Open-Source-Buchhaltung für GmbH und UG">
        <Capabilities>
            <Capability Name="runFullTrust" />
            
        </Capabilities>
        <Applications>
            <Application
                Id="com.buchfink.app"
                Description="Open-Source-Buchhaltung für GmbH und UG"
                DisplayName="Buchfink"
                ExecutableName="buchfink"
                EntryPoint="Windows.FullTrustApplication">
                
            </Application>
        </Applications>
        <Resources>
            <Resource Language="en-us" />
        </Resources>
        <Dependencies>
            <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.19041.0" />
        </Dependencies>
        <Properties>
            <Framework>false</Framework>
            <DisplayName>Buchfink</DisplayName>
            <PublisherDisplayName>Buchfink Open Source</PublisherDisplayName>
            <Description>Open-Source-Buchhaltung für GmbH und UG</Description>
            <Logo>Assets\AppIcon.png</Logo>
        </Properties>
    </PackageInformation>
    <SaveLocation PackagePath="buchfink.msix" />
    <PackageIntegrity>
        <CertificatePath></CertificatePath>
    </PackageIntegrity>
</MsixPackagingToolTemplate>
